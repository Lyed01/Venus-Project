* text=auto
*.ini text eol=lf
*.cpp text
*.h text
*.cs text
*.uproject text
*.uplugin text

# Binarios de Unreal -> LFS (con lock para evitar merges imposibles)
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

# Arte y audio -> LFS
*.fbx filter=lfs diff=lfs merge=lfs -text
